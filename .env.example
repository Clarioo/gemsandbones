# ---- Discord OAuth2 ----
# Create an app at https://discord.com/developers/applications
# OAuth2 tab -> copy Client ID and Client Secret.
# OAuth2 tab -> Redirects -> add BOTH of these URLs:
#   http://localhost:3000/auth/discord/callback
#   https://gemsandbones.online/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Use the localhost one for local dev, the gemsandbones.online one on the VPS.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# ---- Session ----
# Secret used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Session store ----
# Leave this UNSET locally to use the simple in-memory store.
# On the VPS, set it so sessions live in Redis and survive restarts:
#   REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL=

# ---- Server ----
PORT=3000
# "development" locally, "production" on the VPS (enables secure cookies behind HTTPS)
NODE_ENV=development
